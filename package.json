{
  "name": "dsh-eval21-explorer",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "Interactive 21cmEVAL lightcone evaluation explorer for the Harness Web UI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "data.js",
    "ssh.js",
    "remote.py",
    "defaults.json",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "hdf5.js",
    "hdf5_reader.py",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "author": "Haris Kapetanovic",
  "keywords": [
    "21cm",
    "eval21",
    "lightcone",
    "harness",
    "dsh",
    "visualization"
  ]
}
